{
  "manifest_version": 3,
  "name": "Newspoem",
  "short_name": "Newspoem",
  "version": "1.0.0",
  "description": "Turns news articles into blackout poems. Words are redacted in real time, leaving behind hidden poetry on any major news site.",
  "homepage_url": "https://josephruocco.net",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "*://*.nytimes.com/*",
    "*://*.wsj.com/*",
    "*://*.washingtonpost.com/*",
    "*://*.theguardian.com/*",
    "*://*.bbc.com/*",
    "*://*.cnn.com/*",
    "*://*.foxnews.com/*",
    "*://*.reuters.com/*",
    "*://*.apnews.com/*",
    "*://*.bloomberg.com/*",
    "*://*.ft.com/*",
    "*://*.economist.com/*",
    "*://*.newyorker.com/*",
    "*://*.theatlantic.com/*",
    "*://*.nbcnews.com/*",
    "*://*.cbsnews.com/*",
    "*://*.abcnews.go.com/*"
  ],
  "action": {
    "default_title": "Newspoem",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.nytimes.com/*",
        "*://*.wsj.com/*",
        "*://*.washingtonpost.com/*",
        "*://*.theguardian.com/*",
        "*://*.bbc.com/*",
        "*://*.cnn.com/*",
        "*://*.foxnews.com/*",
        "*://*.reuters.com/*",
        "*://*.apnews.com/*",
        "*://*.bloomberg.com/*",
        "*://*.ft.com/*",
        "*://*.economist.com/*",
        "*://*.newyorker.com/*",
        "*://*.theatlantic.com/*",
        "*://*.nbcnews.com/*",
        "*://*.cbsnews.com/*",
        "*://*.abcnews.go.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
